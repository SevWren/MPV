--- a/scripts/webm.lua
+++ b/scripts/webm.lua
@@ -1790,7 +1790,16 @@ encode = function(region, startTime, endTime)
-  for token in string.gmatch(options.additional_flags, "[^%s]+") do
-    command[#command + 1] = token
